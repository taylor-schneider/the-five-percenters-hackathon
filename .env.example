# Copy to .env and fill in. .env is gitignored -- never commit a real key.
#
#   cp .env.example .env

# --- Anthropic ---
# Required once the agent implementations land.
ANTHROPIC_API_KEY=sk-ant-...

# Model for all three agents. claude-opus-5 is the current default;
# override per-agent in code if an agent needs something different.
GM_AGENT_MODEL=claude-opus-5

# Which agent implementation the API resolves to:
#   stub      -- honest placeholders, no API calls, no key needed (default)
#   anthropic -- the real agents (lands from the agent branch)
GM_AGENT_IMPL=stub

# --- API ---
GM_REQUIRE_API_KEY=false
GM_API_KEY=hackathon-dev-key
